<?xml version="1.0" encoding="utf-8"?>
<!-- A track row; raised while focused or playing. -->
<component name="SongItem" extends="Group">
    <script type="text/brightscript" uri="SongItem.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/api.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="draw" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" onChange="onFocus" />
    </interface>
</component>
